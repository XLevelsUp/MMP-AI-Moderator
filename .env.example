# Every setting the servers read from the environment. Copy to the right file on each server
# (see docs/DEPLOY.md) and fill in. Never commit the filled-in copy.

# ---------- both servers ----------
APP_ENV=production                 # production refuses to start without the settings it needs
LOG_FORMAT=json                    # one JSON object per log line
LOG_LEVEL=INFO
MEDIA_ALLOWED_HOSTS=abcdefgh.supabase.co   # your Supabase project host, no https://

# ---------- API server only (api.env) ----------
API_KEYS=                          # comma-separated, each at least 32 characters: openssl rand -hex 32
QUEUE_ENABLED=true
REDIS_PASSWORD=                    # openssl rand -hex 24; the compose file builds REDIS_URL from it
REDIS_BIND_IP=                     # this server's private VPC IP, so only the VPC reaches Redis

# ---------- GPU worker only (worker.env) ----------
REDIS_URL=redis://:<REDIS_PASSWORD>@<API server private IP>:6379/0
DATABASE_URL=postgresql://moderation_service.<project ref>:<password>@<pooler host>:5432/postgres?sslmode=require
# Set in the image already; change only if needed:
# ML_DEVICE=cuda  ML_DTYPE=float16  FFMPEG_HWACCEL=cuda  GUARD_MODEL=shieldstral
# HF_HOME=/models/hf  EASYOCR_MODEL_DIR=/models/easyocr  WORKER_EXIT_WHEN_EMPTY=true

# ---------- laptop / development (the old .env.example): use these instead of the above ----------
# APP_ENV=development
# LOG_FORMAT=text
# REDIS_URL=redis://127.0.0.1:6379/0
# HF_HOME=D:\hf-cache
# TORCH_HOME=D:\torch-cache
# HF_HUB_DISABLE_TELEMETRY=1
# HF_HUB_OFFLINE=1
# EASYOCR_MODEL_DIR=D:\easyocr-models
# QUARANTINE_DIR=D:\mmp-quarantine
# QUEUE_ENABLED=false                   # the test page answers inside the API, no worker
# DEMO_DATABASE_URL=                    # local dummy database for the test page only
