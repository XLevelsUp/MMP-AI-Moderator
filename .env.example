# Local development settings. Copy to .env (never commit .env).
# Production servers use deploy/api.env.example and deploy/worker.env.example instead.

APP_ENV=development
LOG_FORMAT=text
LOG_LEVEL=INFO

# Redis from docker-compose.yml
REDIS_URL=redis://127.0.0.1:6379/0

# Where models and temporary files live (Windows example; use any folder with ~20 GB free)
HF_HOME=D:\hf-cache
TORCH_HOME=D:\torch-cache
EASYOCR_MODEL_DIR=D:\easyocr-models
QUARANTINE_DIR=D:\mmp-quarantine
HF_HUB_DISABLE_TELEMETRY=1
# After the first model download, work offline:
HF_HUB_OFFLINE=1

# CPU on a laptop; cuda + float16 on an NVIDIA GPU
ML_DEVICE=cpu
ML_DTYPE=float32
# Shieldstral needs ~8 GB; leave empty on a laptop, shieldstral on a GPU machine
GUARD_MODEL=

# true = POST /api/v1/moderate queues jobs for a worker (run one with: uv run python -m app.worker)
# false = only the test upload route works, answered inside the API with no worker
QUEUE_ENABLED=true

# Only needed to run a worker locally against a test database (never production)
# DATABASE_URL=postgresql://moderation_service:<password>@127.0.0.1:5432/postgres
# MEDIA_ALLOWED_HOSTS=<project-ref>.supabase.co
