# API settings. Copy to /opt/mmp/api.env on the server, fill in, then: chmod 600 /opt/mmp/api.env
# Never commit the filled-in copy. The API never needs the database password.

APP_ENV=production
LOG_FORMAT=json
LOG_LEVEL=INFO

# The only host media links may point to (the Supabase project host, no https://).
# Links must also be under /storage/v1/object/.
MEDIA_ALLOWED_HOSTS=<project-ref>.supabase.co

# Keys the app backend sends in the X-API-Key header. Comma-separated, each at least 32 characters.
# Make one with: openssl rand -hex 32   (give it to the backend team privately)
API_KEYS=

# Requests are queued for the GPU worker.
QUEUE_ENABLED=true

# Redis (runs next to the API, deploy/docker-compose.api.yml builds REDIS_URL from these).
# Password: openssl rand -hex 24   (the worker needs the same one)
REDIS_PASSWORD=
# This server's PRIVATE IP (hostname -I), so only the private network can reach Redis.
# Never open port 6379 to the internet.
REDIS_BIND_IP=
