# systemd unit for the GPU server: start the worker at boot, after Docker and the network.
#   sudo cp deploy/mmp-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable mmp-worker
[Unit]
Description=MeetMyPets moderation GPU worker (stops the server when the queue is empty)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ubuntu
EnvironmentFile=-/etc/default/mmp-worker
ExecStart=/opt/mmp/deploy/run-worker.sh
Restart=no

[Install]
WantedBy=multi-user.target
