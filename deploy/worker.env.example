# GPU worker settings. Copy to /opt/mmp/worker.env on the GPU server, fill in, then:
# chmod 600 /opt/mmp/worker.env   Never commit the filled-in copy.

APP_ENV=production
LOG_FORMAT=json
LOG_LEVEL=INFO

# Same value as in api.env.
MEDIA_ALLOWED_HOSTS=<project-ref>.supabase.co

# The queue. Same password as REDIS_PASSWORD in api.env; the host is the API server's PRIVATE IP
# (on a single machine: that machine's own private IP).
REDIS_URL=redis://:<redis-password>@<api-server-private-ip>:6379/0

# The worker's database login (role moderation_service), Supabase pooler in SESSION mode, port 5432.
# If the password has symbols such as @ : / # % [ ], URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql://moderation_service.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require

# true  = stop when the queue is empty (part-time GPU server that shuts itself down)
# false = keep running (one always-on machine with the API, Redis and the worker together)
WORKER_EXIT_WHEN_EMPTY=true

# Already set in the worker image for a T4; change only if needed:
# ML_DEVICE=cuda  ML_DTYPE=float16  FFMPEG_HWACCEL=cuda  GUARD_MODEL=shieldstral
# HF_HOME=/models/hf  EASYOCR_MODEL_DIR=/models/easyocr
# Optional: CHECK_ROW_PATH=true checks a link is the row's own file (needs migration 20261113100000).
